# ---- Supabase (create the project in region eu-central-1 / Frankfurt) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # services only, never exposed to the browser

# ---- Groq ----
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ---- Internal service mesh ----
# Shared secret used to sign short-lived service tokens (HMAC). 32+ random bytes.
INTERNAL_SERVICE_SECRET=
OCR_SERVICE_URL=http://localhost:4001
LEDGER_SERVICE_URL=http://localhost:4002
CHATBOT_SERVICE_URL=http://localhost:4003

# ---- Enable Banking (PSD2) ----
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PEM=       # RSA private key registered in the Enable Banking control panel
ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/bank/callback

# ---- App ----
APP_URL=http://localhost:3000
