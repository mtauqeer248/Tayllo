# Shared Dockerfile for the microservices. Build with:
#   docker build -f Dockerfile.service --build-arg SERVICE=ocr -t es-ocr .
FROM node:22-slim AS build
ARG SERVICE
WORKDIR /repo
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY services/${SERVICE} ./services/${SERVICE}
RUN npm ci --workspace @es/${SERVICE} --include-workspace-root
RUN npm run build --workspace @es/${SERVICE}
RUN npm prune --omit=dev --workspace @es/${SERVICE}

FROM node:22-slim
ARG SERVICE
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/services/${SERVICE}/dist ./dist
USER node
EXPOSE 8080
ENV PORT=8080
CMD ["node", "dist/server.js"]
